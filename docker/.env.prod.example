# =============================================================================
# Social Dashboard — Production Environment Variables
# Copy this to docker/.env.prod on your server and fill in real values.
# =============================================================================

# ── Docker Image Config ──────────────────────────────────────────────────────
DOCKER_REGISTRY=ghcr.io/YOUR_GITHUB_USERNAME
IMAGE_TAG=latest

# ── Ports (your nginx will proxy to these) ───────────────────────────────────
API_PORT=3000
WEB_PORT=5173

# ── PostgreSQL (External RDS) ───────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@your-rds-host.com:5432/social_dashboard?schema=public

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_strong_random_password

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_run_openssl_rand_hex_32
JWT_REFRESH_SECRET=CHANGE_ME_run_openssl_rand_hex_32

# ── Application ─────────────────────────────────────────────────────────────
FRONTEND_URL=https://your-domain.com
API_PREFIX=api
ENCRYPTION_KEY=CHANGE_ME_run_openssl_rand_hex_16

# ── S3 / LocalStack ─────────────────────────────────────────────────────────
# These are used inside the containers (docker networking).
# S3_ENDPOINT is set automatically via docker-compose.prod.yml to http://localstack:4566
# S3_PUBLIC_URL is how the browser reaches the files — via your server's public IP/domain.
AWS_REGION=us-east-1
S3_ACCESS_KEY=test
S3_SECRET_KEY=test
S3_BUCKET=social-dashboard-uploads
S3_PUBLIC_URL=https://your-domain.com:4566/social-dashboard-uploads
# When you switch to real AWS S3 later, remove S3_ENDPOINT override in docker-compose and set:
# S3_PUBLIC_URL=https://your-bucket.s3.amazonaws.com
